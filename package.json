{
  "name": "queuert-monorepo",
  "private": true,
  "keywords": [],
  "license": "MIT",
  "author": "kvet",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' --reporter=append-only build",
    "lint": "oxlint --type-aware",
    "fmt": "oxlint --type-aware --fix && oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run && pnpm test:bun",
    "test:ci": "vitest --run --retry=2 --maxWorkers=$(($(nproc) - 2)) && pnpm test:bun",
    "test:bun": "pnpm --filter example-state-sqlite-bun test",
    "typecheck": "pnpm -r --reporter=append-only typecheck",
    "benchmarks": "pnpm --filter './benchmarks/*' --workspace-concurrency=1 --reporter=append-only start",
    "examples": "pnpm --filter './examples/*' --reporter=append-only start",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm build && pnpm test && pnpm examples",
    "modules:clean": "rm -rf $(find . -name node_modules -type d)",
    "changeset": "changeset",
    "version": "changeset version",
    "docs:dev": "pnpm --filter @queuert/docs dev",
    "docs:build": "pnpm --filter @queuert/docs build",
    "docs:preview": "pnpm --filter @queuert/docs preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@types/node": "22.20.5",
    "husky": "9.1.7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
