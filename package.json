{
  "name": "queuert-monorepo",
  "private": true,
  "keywords": [],
  "license": "MIT",
  "author": "kvet",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' --reporter=append-only build",
    "lint": "oxlint --type-aware",
    "fmt": "oxlint --type-aware --fix && oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run && pnpm test:bun && pnpm test:node",
    "test:ci": "vitest --run --retry=2 --maxWorkers=$(($(nproc) - 2)) && pnpm test:bun && pnpm test:node",
    "test:bun": "pnpm --filter example-sqlite-state-bun-sqlite --filter example-sqlite-state-bun-sql --filter example-postgresql-state-bun-sql --filter example-mysql-state-bun-sql --filter example-postgresql-notify-bun-sql --filter example-postgresql-notify-redis-bun test",
    "test:node": "pnpm --filter example-sqlite-state-node-sqlite test",
    "typecheck": "pnpm -r --reporter=append-only typecheck",
    "benchmarks": "pnpm --filter './benchmarks/*' --workspace-concurrency=1 --reporter=append-only start",
    "examples": "pnpm --filter './examples/**' --reporter=append-only start",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm build && pnpm test && pnpm examples",
    "modules:clean": "rm -rf $(find . -name node_modules -type d)",
    "changeset": "changeset",
    "version": "changeset version",
    "docs:dev": "pnpm --filter @queuert/docs dev",
    "docs:build": "pnpm --filter @queuert/docs build",
    "docs:preview": "pnpm --filter @queuert/docs preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsdown": "0.23.7",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "oxlint --type-aware --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
