{
  "extends": "@queuert/tsconfig/base",
  "compilerOptions": {
    "composite": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node", "vite/client", "filesystem-routing/types"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "plugins/**/*.ts", "vite.config.ts"],
  "exclude": [
    "node_modules",
    ".output",
    "src/components/integrations/dashboard/demo/service-worker.ts"
  ]
}
