{
  "name": "@queuert/ipc",
  "version": "0.17.0",
  "description": "IPC notify adapter for Queuert",
  "keywords": [
    "background-jobs",
    "ipc",
    "job-queue",
    "queue",
    "task-queue",
    "typescript",
    "unix-socket"
  ],
  "homepage": "https://kvet.github.io/queuert/",
  "bugs": {
    "url": "https://github.com/kvet/queuert/issues"
  },
  "license": "MIT",
  "author": "kvet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvet/queuert.git",
    "directory": "packages/ipc"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@queuert/helpers": "workspace:*",
    "@queuert/tsconfig": "workspace:*",
    "queuert": "workspace:*"
  },
  "peerDependencies": {
    "queuert": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
