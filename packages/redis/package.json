{
  "name": "@queuert/redis",
  "version": "0.17.0",
  "description": "Redis state and notify adapters for Queuert",
  "keywords": [
    "background-jobs",
    "job-queue",
    "pub-sub",
    "queue",
    "redis",
    "task-queue",
    "typescript"
  ],
  "homepage": "https://kvet.github.io/queuert/",
  "bugs": {
    "url": "https://github.com/kvet/queuert/issues"
  },
  "license": "MIT",
  "author": "kvet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvet/queuert.git",
    "directory": "packages/redis"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./conformance-internal": "./src/conformance-internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./conformance": "./dist/conformance.mjs",
      "./conformance-internal": "./dist/conformance-internal.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@queuert/helpers": "workspace:*",
    "@queuert/testcontainers": "workspace:*",
    "@queuert/tsconfig": "workspace:*",
    "@queuert/typed-sql": "workspace:*",
    "ioredis": "6.0.0",
    "queuert": "workspace:*",
    "redis": "6.3.1"
  },
  "peerDependencies": {
    "queuert": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
