{
  "name": "@queuert/dashboard",
  "version": "0.17.0",
  "description": "Embeddable web dashboard for Queuert job-chain observation",
  "keywords": [
    "background-jobs",
    "dashboard",
    "job-queue",
    "monitoring",
    "queue",
    "typescript"
  ],
  "homepage": "https://kvet.github.io/queuert/",
  "bugs": {
    "url": "https://github.com/kvet/queuert/issues"
  },
  "license": "MIT",
  "author": "kvet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvet/queuert.git",
    "directory": "packages/dashboard"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "pnpm build:frontend && tsdown",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@queuert/tsconfig": "workspace:*",
    "@queuert/ui": "workspace:*",
    "@solidjs/router": "1.0.1",
    "@tailwindcss/vite": "4.3.4",
    "queuert": "workspace:*",
    "seroval": "1.7.7",
    "solid-js": "1.9.18",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "peerDependencies": {
    "queuert": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "inlinedDependencies": {
    "seroval": "1.7.7"
  }
}
