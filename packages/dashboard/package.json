{
  "name": "@queuert/dashboard",
  "version": "0.16.0",
  "description": "Embeddable web dashboard for Queuert job-chain observation",
  "keywords": [
    "background-jobs",
    "dashboard",
    "job-queue",
    "monitoring",
    "queue",
    "typescript"
  ],
  "homepage": "https://kvet.github.io/queuert/",
  "bugs": {
    "url": "https://github.com/kvet/queuert/issues"
  },
  "license": "MIT",
  "author": "kvet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvet/queuert.git",
    "directory": "packages/dashboard"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun run build:frontend && tsdown",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@queuert/tsconfig": "workspace:*",
    "@solidjs/router": "1.0.0",
    "@tailwindcss/vite": "4.3.3",
    "queuert": "workspace:*",
    "seroval": "1.6.8",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2",
    "vite-plugin-solid": "2.11.14"
  },
  "peerDependencies": {
    "queuert": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "inlinedDependencies": {
    "seroval": "1.6.8"
  },
  "x-examples": "https://github.com/kvet/queuert/tree/main/examples",
  "x-llms-txt": "https://kvet.github.io/queuert/llms-full.txt"
}
