  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=12288 src/postgres.ts && node --max-old-space-size=12288 src/sqlite.ts && node --max-old-space-size=12288 src/mysql.ts && node --max-old-space-size=12288 src/mysql.ts --mariadb && node --max-old-space-size=12288 src/redis.ts",
    "start:postgres": "node --max-old-space-size=12288 src/postgres.ts",
    "start:sqlite": "node --max-old-space-size=12288 src/sqlite.ts",
    "start:mysql": "node --max-old-space-size=12288 src/mysql.ts",
    "start:mariadb": "node --max-old-space-size=12288 src/mysql.ts --mariadb",
    "start:redis": "node --max-old-space-size=12288 src/redis.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@queuert/mysql": "workspace:*",
    "@queuert/mysql-schema-v1": "npm:@queuert/mysql@0.18.0",
