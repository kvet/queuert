    "@queuert/sqlite": "workspace:*",
    "@queuert/sqlite-schema-v1": "npm:@queuert/sqlite@0.18.0",
    "benchmark-results": "workspace:*",
    "better-sqlite3": "13.2.0",
    "example-mysql-state-mysql2": "workspace:*",
    "example-postgresql-state-pg": "workspace:*",
    "example-redis-state-ioredis": "workspace:*",
    "example-sqlite-state-better-sqlite3": "workspace:*",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "queuert-schema-v1": "npm:queuert@0.18.0"
  },
  "devDependencies": {
    "@queuert/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
