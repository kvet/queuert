{
  "name": "benchmark-memory-footprint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --all",
    "start:state-postgres": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --state-postgres",
    "start:state-sqlite": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --state-sqlite",
    "start:notify-redis": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --notify-redis",
    "start:notify-postgres": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --notify-postgres",
    "start:notify-nats": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --notify-nats",
    "start:otel": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --otel",
    "start:dashboard": "node --expose-gc --no-flush-bytecode --import=tsx src/index.ts --dashboard",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@queuert/dashboard": "workspace:*",
    "@queuert/nats": "workspace:*",
    "@queuert/otel": "workspace:*",
    "@queuert/postgres": "workspace:*",
    "@queuert/redis": "workspace:*",
    "@queuert/sqlite": "workspace:*",
    "better-sqlite3": "13.0.3",
    "example-notify-postgres-postgres-js": "workspace:*",
    "example-notify-redis-redis": "workspace:*",
    "example-state-postgres-postgres-js": "workspace:*",
    "example-state-sqlite-better-sqlite3": "workspace:*",
    "nats": "2.29.3",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "queuert": "workspace:*",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@queuert/tsconfig": "workspace:*",
    "@testcontainers/nats": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1"
  }
}
